API_BASE_URL=https://rahulshettyacademy.com/api/ecom
TEST_USER_EMAIL=<test-account-a-email>
TEST_USER_PASSWORD=<test-account-a-password>
TEST_USER_2_EMAIL=<test-account-b-email>
TEST_USER_2_PASSWORD=<test-account-b-password>
